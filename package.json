{
  "name": "lobby",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter=./packages/* --filter=./apps/* dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:shared": "pnpm --filter @lobby/shared dev",
    "build": "pnpm --filter @lobby/shared build && pnpm --filter api build && pnpm --filter web build",
    "build:web": "pnpm --filter @lobby/shared build && pnpm --filter web build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "prepare": "husky",
    "web:ng": "docker compose exec web pnpm --dir apps/web exec ng",
    "api:pnpm": "docker compose exec api pnpm --dir apps/api",
    "web:pnpm": "docker compose exec web pnpm --dir apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "typescript-eslint": "^8.5.0",
    "prettier": "^3.3.3",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.9",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,html,scss,css}": [
      "prettier --write"
    ]
  }
}
