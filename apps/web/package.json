{
  "name": "web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/clear-vite-cache.mjs && ng serve",
    "dev": "node scripts/clear-vite-cache.mjs && ng serve",
    "build": "ng build",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "load-test:guest-call": "node scripts/guest-call-load-test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:client": "node dist/client/server/server.mjs",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css,scss}\""
  },
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.0",
    "@lobby/shared": "workspace:*",
    "@lucide/angular": "^1.28.0",
    "@supabase/supabase-js": "^2.45.4",
    "express": "^5.1.0",
    "livekit-client": "^2.21.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "uqr": "^0.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@livekit/rtc-node": "0.13.31",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
