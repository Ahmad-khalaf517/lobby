# Copy to apps/api/.env and fill in. NEVER commit the filled-in file.

# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE ROLE key, not the anon key. It bypasses Row Level Security.
# Server-side only. If this reaches the browser, anyone can read and
# delete every room in the database.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# LiveKit — cloud.livekit.io → Settings → Keys
# ---------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:4200
